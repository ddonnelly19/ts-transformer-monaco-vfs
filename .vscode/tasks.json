{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "dev",
			"group": "build",
			"problemMatcher": {
				"pattern": {
					"regexp": "^.*ready in.*ms.*$",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*$",
					"endsPattern": "^.*(ready in|Local:).*$"
				}
			},
			"label": "npm: dev",
			"isBackground": true
		},
		{
			"type": "npm",
			"script": "generate:internal-dts",
			"group": "build",
			"problemMatcher": [],
			"label": "npm: generate:internal-dts"
		}
	]
}
