{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "msedge",
			"name": "Launch Microsoft Edge",
			"request": "launch",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}",
			"userDataDir": "${workspaceFolder}/.vscode/edge-debug-profile",
			"runtimeArgs": [
				"--remote-allow-origins=*"
			],
			"preLaunchTask": "npm: dev"
		}
	]
}
