{
	"target": "ES2022",
	"module": "ESNext",
	"strict": true,
	"noImplicitAny": true,
	"noUncheckedIndexedAccess": true,
	"allowJs": true,
	"checkJs": true,
	"allowSyntheticDefaultImports": true,
	"paths": {
		"typescript": [
			"file:///typescript.d.ts"
		]
	},
	"removeComments": true,
	"declaration": true,
	"emitDeclarationOnly": false,
	"newLine": "LineFeed",
	"outDir": "dist",
	"pathsBasePath": "",
	"allowNonTsExtensions": true
}